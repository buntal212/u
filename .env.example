UIH_UID=1000
UIH_GID=1000

DB_CONNECTION=mysql
DB_DATABASE=uih_development
DB_USERNAME=uih_dev
DB_PASSWORD=replace-with-a-random-local-value
UIH_DB_ROOT_PASSWORD=replace-with-a-separate-random-local-value

