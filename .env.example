APP_NAME="Udumbara Internal Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8011
APP_LOCALE=id

UIH_API_PORT=8011
UIH_UID=1000
UIH_GID=1000

DB_CONNECTION=mysql
DB_DATABASE=uih_development
DB_USERNAME=uih_dev
DB_PASSWORD=replace-with-a-random-local-value
UIH_DB_ROOT_PASSWORD=replace-with-a-separate-random-local-value

# Catalog ASU Sources
CATALOG_SOURCE_MODE=auto

ASU_SOURCES='{
  "larissama": {
    "name": "Larissama",
    "url": "http://larissama-api:8000",
    "token": "${LARISSAMA_TOKEN}",
    "timeout": 2,
    "connect_timeout": 1,
    "search_path": "/api/v1/s2s/catalog/search"
  },
  "laundry": {
    "name": "Laundry",
    "url": "http://laundry-api:8000",
    "token": "${LAUNDRY_TOKEN}",
    "timeout": 2,
    "connect_timeout": 1,
    "search_path": "/api/v1/s2s/catalog/search"
  },
  "asset": {
    "name": "Asset",
    "url": "http://aset-api:8000",
    "token": "${ASSET_TOKEN}",
    "timeout": 2,
    "connect_timeout": 1,
    "search_path": "/api/v1/s2s/catalog/search"
  }
}'

LARISSAMA_TOKEN=replace-with-larissama-token
LAUNDRY_TOKEN=replace-with-laundry-token
ASSET_TOKEN=replace-with-asset-token
